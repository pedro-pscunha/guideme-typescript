{
  "name": "@guideme/sdk",
  "version": "0.2.0",
  "description": "Make a TypeSafe Jev judgment usable as control flow: a yes/no is an if, a choice is an exhaustive switch, a score is a comparison.",
  "license": "MIT OR Apache-2.0",
  "author": "Pedro Cunha",
  "homepage": "https://github.com/pedro-pscunha/guideme-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedro-pscunha/guideme-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/pedro-pscunha/guideme-typescript/issues"
  },
  "keywords": [
    "typesafe",
    "jev",
    "llm",
    "classification",
    "control-flow",
    "opentelemetry"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-tsdoc": "0.5.3",
    "fallow": "3.28.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.8",
    "publint": "0.3.24",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
